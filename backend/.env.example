# Copy to .env and fill in real values. NEVER commit .env.
PORT=5002
MONGO_URI=mongodb://127.0.0.1:27017/fikretak
CLIENT_URL=http://localhost:5173
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Cloudinary (image uploads). Leave blank locally to fall back to disk storage.
# Get these from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
